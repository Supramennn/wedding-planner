rules_version = '2';

// WedPlan — Firebase Storage Rules
// Struk pengeluaran disimpan per user: users/{uid}/receipts/...
// Prinsip: hanya pemilik yang boleh baca/tulis/hapus; user lain DENY.
//
// Catatan pemisahan rule:
// - request.resource.size hanya valid saat WRITE (upload); pada READ/DELETE
//   request.resource = null → evaluasi propertinya error dan menolak operasi.
//   Karena itu read/write/delete dipisah menjadi allow terpisah.
service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/{allPaths=**} {
      // Baca struk milik sendiri (mis. tombol "Lihat struk").
      allow read: if isOwner(userId);
      // Upload: maksimal 5 MB (sinkron dengan validasi di aplikasi).
      allow write: if isOwner(userId)
                   && request.resource.size < 5 * 1024 * 1024;
      // Hapus file struk (dipanggil saat pengeluaran dihapus).
      allow delete: if isOwner(userId);
    }
  }
}
