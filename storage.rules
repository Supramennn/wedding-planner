rules_version = '2';

// WedPlan — Firebase Storage Rules
// Struk pengeluaran disimpan per workspace: users/{uid}/receipts/...
// Prinsip: PEMILIK workspace atau PASANGAN TERTAUT (kolaborasi Phase 2)
// yang boleh baca/tulis/hapus; user lain DENY.
// Pasangan dicek DUA arah (partnerUid ATAU linkedTo di dokumen terkait)
// supaya pemilik bisa membuka struk lama pasangan hasil merge (Phase 2).
//
// Catatan pemisahan rule:
// - request.resource.size hanya valid saat WRITE (upload); pada READ/DELETE
//   request.resource = null → evaluasi propertinya error dan menolak operasi.
//   Karena itu read/write/delete dipisah menjadi allow terpisah.
// - Storage rules tidak punya request.auth.uid vs path couple → cek tautan
//   dilakukan via firestore.get() ke dokumen profil (rules v2 cross-service).
service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Pasangan tertaut — DUA arah, via firestore.get() ke dokumen profil:
    //  1) folder workspace (users/{pemilik}): partnerUid pasangan itu == auth
    //     → pasangan mengakses struk workspace yang ditautkan;
    //  2) folder milik pasangan (users/{pasangan}): linkedTo == auth
    //     → PEMILIK masih bisa membuka struk lama pasangan (hasil merge).
    // keys().hasAny(...) menjaga dokumen legacy yang belum punya field couple
    // (mengakses field yang tidak ada memicu error → deny salah sasaran);
    // dokumen tanpa profil sama sekali → get() error → deny (memang bukan
    // pasangan). isOwner() di depan membuat pemilik tak pernah kena get().
    function profileOf(userId) {
      return firestore.get(/databases/(default)/documents/users/$(userId)).data;
    }

    function isCouple(userId) {
      return isOwner(userId)
        || (request.auth != null
            && profileOf(userId).keys().hasAny(['partnerUid'])
            && profileOf(userId).partnerUid == request.auth.uid)
        || (request.auth != null
            && profileOf(userId).keys().hasAny(['linkedTo'])
            && profileOf(userId).linkedTo == request.auth.uid);
    }

    match /users/{userId}/{allPaths=**} {
      // Baca struk milik sendiri / pasangan (mis. tombol "Lihat struk").
      allow read: if isCouple(userId);
      // Upload: maksimal 5 MB (sinkron dengan validasi di aplikasi).
      allow write: if isCouple(userId)
                   && request.resource.size < 5 * 1024 * 1024;
      // Hapus file struk (dipanggil saat pengeluaran dihapus).
      allow delete: if isCouple(userId);
    }
  }
}
