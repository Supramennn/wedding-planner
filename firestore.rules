rules_version = '2';

// WedPlan — Firestore Security Rules
// Prinsip: data di bawah users/{userId} hanya boleh diakses PEMILIK workspace
// (owner) atau pasangannya yang sudah ditautan (kolaborasi Phase 2).
// Tidak ada rule allow lain => path lain otomatis DENY (default deny).
//
// Catatan evaluasi (diuji di scripts/test-couple-rules.mjs):
// - || dan && memakai short-circuit: isOwner() di depan membuat pembaca
//   solo tidak pernah mengevaluasi get()/akses field yang belum ada.
// - Akses subcollection pakai get() pada path TETAP (induk) → untuk operasi
//   list rules dievaluasi sekali (resource-independent), aman kuota.
// - Field 'coupleStatus' sengaja selalu ada di dokumen baru (user-service
//   EMPTY_PROFILE) supaya ekspresi rules tidak pernah error "No such
//   property" saat membandingkan dengan string.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Email sudah dibuktikan milk pemohon lewat tautan verifikasi.
    // Wajib untuk SEMUA operasi yang lintas akun (klaim undangan, unlink
    // dua arah) karena email alone bukan bukti kepemilikan mailbox: siapa
    // pun yang tahu alamat seseorang bisa mendaftar dengan alamat itu.
    function isVerifiedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Pasangan TERTAUT — akses baca penuh.
    // resource = dokumen yang dibaca/ditulis (create → null, dijaga null-check).
    function isLinkedPartner() {
      return isSignedIn() && resource != null
        && resource.data.partnerUid == request.auth.uid;
    }

    // Akun penerima UNDANGAN (email sama dengan partnerEmail di dokumen).
    // Berlaku untuk: baca profil (menemukan undangan via query) & klaim terbatas.
    // Butuh email terverifikasi, lihat isVerifiedEmail().
    function isInvitee() {
      return isVerifiedEmail() && resource != null
        && resource.data.partnerEmail == request.auth.token.email;
    }

    /**
     * Field profil yang BOLEH diubah pasangan tertaut.
     *
     * Sempit dengan sengaja. Pasangan adalah co-owner data pernikahan, bukan
     * pemilik akun: dia boleh mengisi tanggal, lokasi, nama, dan total
     * budget, tapi TIDAK boleh menukar siapa pemilik workspace.
     *
     * Field yang TIDAK ada di sini dan hanya boleh disentuh owner:
     *   email         — identitas akun
     *   partnerEmail  — siapa yang diundang
     *   partnerUid    — siapa yang tertaut  (diklaim hanya lewat isInvitee)
     *   linkedTo      — arah tautan akun sendiri
     *   coupleStatus  — status undangan/tautan
     *   fcmTokens     — token push milik AKUN itu (bukan data bridal)
     *   createdAt
     *
     * `mergedFromUid`/`mergedAt` tetap boleh karena penanda idempoten merge
     * ditulis pasangan saat menyalin datanya sendiri (couple-service).
     */
    function writesOnlySharedProfile() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['displayName', 'partnerName', 'weddingDate', 'venue',
                  'totalBudget', 'mergedFromUid', 'mergedAt']);
    }

    // Akses workspace via induk — untuk pemilik MAUPUN pasangan tertaut.
    // Cek dua arah (resiprositas): target menunjuk ke pemohon DAN dokumen
    // pemohon menunjuk balik. Tanpa resiprositas, pasangan bisa menulis
    // partnerUid = <uid pihak ketiga> di dokumen pemilik dan pihak ketiga
    // itu langsung mendapat akses penuh tanpa persetujuan siapa pun.
    function hasWorkspaceAccess(userId) {
      return isOwner(userId) || (
        isSignedIn()
        && get(/databases/$(database)/documents/users/$(userId)).data.partnerUid
           == request.auth.uid
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedTo
           == userId
      );
    }

    // Profil pernikahan (sumber tunggal data onboarding)
    match /users/{userId} {
      // Pemilik workspace / user solo: baca & tulis penuh.
      allow read, write: if isOwner(userId);

      // Pasangan tertaut: BACA penuh…
      allow read: if isLinkedPartner();

      // … tapi TIDAK boleh menghapus dokumen profil. `write` di atas
      // menutup delete untuk pasangan, sehingga hasWorkspaceAccess tetap
      // bisa resolve get() dan kedua pihak tidak terkunci dari subcollection
      // masing-masing.
      // …dan TIDAK boleh menulis field di luar isSharedProfileField(),
      // supaya tidak bisa menukar pemilik workspace.
      allow update: if isLinkedPartner() && writesOnlySharedProfile();

      // Penerima undangan: baca profil ini — wajib untuk query
      // `users where partnerEmail == <email sendiri>` (auto-claim).
      allow read: if isInvitee();

      // …dan mengklaim tautan HANYA untuk dirinya sendiri, terbatas
      // pada dua field tautan, dan HANYA pada undangan yang masih hidup:
      //   - partnerUid harus masih kosong (atau memang sudah dirinya),
      //     supaya penerima undangan baru tidak bisa menggeser pasangan
      //     yang sudah tertaut.
      //   - coupleStatus harus "invited", supaya undangan yang sudah
      //     dibatalkan atau sudah linked tidak bisa diklaim ulang.
      allow update: if isInvitee()
        && request.resource.data.partnerUid == request.auth.uid
        && (resource.data.partnerUid == null
            || resource.data.partnerUid == request.auth.uid)
        && resource.data.coupleStatus == 'invited'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['partnerUid', 'coupleStatus']);

      // Pasangan tertaut boleh MELEPAS tautannya: membersihkan field
      // tautan di dokumen pemilik (couple-service.unlinkCouple).
      // Syarat partnerUid == null pada hasil akhirnya membuat pasangan
      // hanya bisa MENCABUT akses, tidak bisa menunjuk akses itu ke orang
      // lain. Inilah satu-satunya jalan dari sisi pasangan yang boleh
      // menyentuh partnerUid.
      allow update: if isVerifiedEmail() && isLinkedPartner()
        && request.resource.data.partnerUid == null
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['partnerUid', 'partnerEmail', 'coupleStatus']);

      // Pemilik boleh menutup tautan dokumen pasangannya (dipakai unlink
      // dua arah) — terbatas field tautan. Tidak perlu email terverifikasi:
      // dokumen yang dituju sudah menunjuk ke pemohon, jadi ini hanya
      // membersihkan tautan milik sendiri, tanpa menyentuh data orang lain.
      allow update: if isSignedIn() && resource != null
        && resource.data.linkedTo == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['linkedTo', 'coupleStatus']);

      // Checklist persiapan
      match /checklist/{itemId} {
        allow read, write: if hasWorkspaceAccess(userId);
      }

      // Budget per kategori (expenses adalah array field di dokumen ini)
      match /budget/{categoryId} {
        allow read, write: if hasWorkspaceAccess(userId);
      }

      // Timeline vendor
      match /vendors/{vendorId} {
        allow read, write: if hasWorkspaceAccess(userId);
      }

      // Daftar tamu undangan (estimasi jumlah tamu per status & kelompok)
      match /guests/{guestId} {
        allow read, write: if hasWorkspaceAccess(userId);
      }

      // Item yang perlu disiapkan (daftar belanja — modul budget)
      match /prepItems/{itemId} {
        allow read, write: if hasWorkspaceAccess(userId);
      }

      // Foto struk pengeluaran (gambar terkompres — bytes; pengganti Storage)
      match /receipts/{receiptId} {
        allow read, write: if hasWorkspaceAccess(userId);
      }

      // Log pengiriman reminder (hanya Admin SDK server; client DENY).
      match /reminderLog/{logId} {
        allow read, write: if false;
      }
    }
  }
}
