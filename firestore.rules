rules_version = '2';

// WedPlan — Firestore Security Rules
// Prinsip: data di bawah users/{userId} hanya boleh diakses PEMILIK workspace
// (owner) atau pasangannya yang sudah ditautan (kolaborasi Phase 2).
// Tidak ada rule allow lain => path lain otomatis DENY (default deny).
//
// Catatan evaluasi (diuji di scripts/test-couple-rules.mjs):
// - || dan && memakai short-circuit: isOwner() di depan membuat pembaca
//   solo tidak pernah mengevaluasi get()/akses field yang belum ada.
// - Akses subcollection pakai get() pada path TETAP (induk) → untuk operasi
//   list rules dievaluasi sekali (resource-independent), aman kuota.
// - Klaim undangan: pasangan mengirim email cocok dengan request.auth.token.email
//   hanya boleh menyentuh field partnerUid & coupleStatus di dokumen pemilik.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Pasangan TERTAUT — akses penuh (kolaborasi realtime dua arah).
    // resource = dokumen yang dibaca/ditulis (create → null, dijaga null-check).
    function isLinkedPartner() {
      return isSignedIn() && resource != null
        && resource.data.partnerUid == request.auth.uid;
    }

    // Akun penerima UNDANGAN (email sama dengan partnerEmail di dokumen).
    // Berlaku untuk: baca profil (menemukan undangan via query) & klaim terbatas.
    function isInvitee() {
      return isSignedIn() && resource != null
        && resource.data.partnerEmail == request.auth.token.email;
    }

    // Akses workspace via induk — untuk pemilik MAUPUN pasangan tertaut.
    function hasWorkspaceAccess(userId) {
      return isOwner(userId) || (
        isSignedIn()
        && get(/databases/$(database)/documents/users/$(userId)).data.partnerUid
           == request.auth.uid
      );
    }

    // Profil pernikahan (sumber tunggal data onboarding)
    match /users/{userId} {
      // Pemilik workspace / user solo: baca & tulis penuh.
      allow read, write: if isOwner(userId);

      // Pasangan tertaut: penuh (edit profil, alokasi, totalBudget, fcmTokens).
      allow read, write: if isLinkedPartner();

      // Penerima undangan: baca profil ini — wajib untuk query
      // `users where partnerEmail == <email sendiri>` (auto-claim).
      allow read: if isInvitee();

      // …dan mengklaim tautan HANYA untuk dirinya sendiri, terbatas
      // pada dua field tautan (tidak bisa mengubah data lain).
      allow update: if isInvitee()
        && request.resource.data.partnerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['partnerUid', 'coupleStatus']);

      // Pemilik boleh menautkan/menutup tautan dokumen pasangannya
      // (dipakai unlink dua arah) — terbatas field tautan.
      allow update: if isSignedIn() && resource != null
        && resource.data.linkedTo == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['linkedTo', 'coupleStatus']);

      // Checklist persiapan
      match /checklist/{itemId} {
        allow read, write: if hasWorkspaceAccess(userId);
      }

      // Budget per kategori (expenses adalah array field di dokumen ini)
      match /budget/{categoryId} {
        allow read, write: if hasWorkspaceAccess(userId);
      }

      // Timeline vendor
      match /vendors/{vendorId} {
        allow read, write: if hasWorkspaceAccess(userId);
      }

      // Daftar tamu undangan (estimasi jumlah tamu per status & kelompok)
      match /guests/{guestId} {
        allow read, write: if hasWorkspaceAccess(userId);
      }

      // Item yang perlu disiapkan (daftar belanja — modul budget)
      match /prepItems/{itemId} {
        allow read, write: if hasWorkspaceAccess(userId);
      }

      // Foto struk pengeluaran (gambar terkompres — bytes; pengganti Storage)
      match /receipts/{receiptId} {
        allow read, write: if hasWorkspaceAccess(userId);
      }

      // Log pengiriman reminder (hanya Admin SDK server; client DENY).
      match /reminderLog/{logId} {
        allow read, write: if false;
      }
    }
  }
}
