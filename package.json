{
  "name": "wedding-planner",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:text": "node scripts/check-text.mjs .",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --import ./scripts/ts-alias.mjs --test \"lib/**/*.test.ts\"",
    "test:rules": "node scripts/test-couple-rules.mjs",
    "verify": "npm run check:text && npm run lint && npm run typecheck && npm run test",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "framer-motion": "^13.4.1",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
